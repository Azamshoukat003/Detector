# ---- NextAuth ----
# Base URL of this app. Locally: http://localhost:3000
# On Vercel this is inferred, but setting it explicitly is safer.
NEXTAUTH_URL=http://localhost:3000
# Random secret used to sign the session JWT.
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=

# ---- GitHub OAuth App ----
# From https://github.com/settings/developers -> OAuth Apps -> New OAuth App
GITHUB_ID=
GITHUB_SECRET=

# ---- Webhook: inbound (GitHub -> repo-guard) ----
# The "Secret" you set on the GitHub webhook. Required; without it
# /api/webhook rejects every request.
GITHUB_WEBHOOK_SECRET=

# ---- Webhook: outbound (repo-guard -> you) ----
# Where force-push / sensitive-file alerts get delivered.
# ALERT_WEBHOOK_KIND is "discord" or "slack".
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KIND=discord

# ---- Local filesystem check (optional) ----
# The "local check" button walks a folder on the machine running repo-guard
# looking for dropper artifacts. It is ON by default on a local dev server and
# OFF anywhere that looks like production; it is hard-off on Vercel regardless.
# Set to 1 to force it on (e.g. a self-hosted `next start` on your own box),
# or 0 to force it off. Never enable it on a deployment other people can reach.
ENABLE_LOCAL_SCAN=
